# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- Linq (iMessage/RCS/SMS) ----
# Dashboard → API keys
LINQ_API_KEY=
# Printed by `npm run setup:webhook` when the subscription is created
LINQ_WEBHOOK_SECRET=
# Pinned so the inbound payload shape can't change under the handler
LINQ_WEBHOOK_VERSION=2026-02-03

# ---- Stripe (bill splitting) ----
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- DoorDash CLI ----
DD_CLI_BINARY=dd-cli
# Only needed where there's no OS keychain (containers, servers, CI).
# Get it on a desktop machine with: dd-cli export-token
DD_CLI_ACCESS_TOKEN=
DD_CLI_TIMEOUT_MS=60000

# ---- Service ----
PORT=3000
# Public HTTPS origin; both webhook subscriptions and Stripe return URLs are built
# from this. With a tunnel, e.g. https://your-subdomain.ngrok.app
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=data/app.sqlite

# ---- Contact card shown to recipients ----
CONTACT_CARD_FIRST_NAME=Chow
CONTACT_CARD_LAST_NAME=Bot
CONTACT_CARD_IMAGE_URL=

# ---- Deliverability limits (Linq guidance; override only if you know why) ----
LIMIT_MESSAGES_PER_LINE_PER_DAY=7000
LIMIT_NEW_CONVERSATIONS_PER_LINE_PER_DAY=40
LIMIT_RAMP_MULTIPLIER=2
LIMIT_RAMP_FLOOR=50
CONTACT_CARD_RESHARE_HOURS=24

# ---- Cadence back-off ----
CADENCE_MAX_UNANSWERED_OUTBOUND=3
CADENCE_FIRST_FOLLOWUP_HOURS=24
CADENCE_SECOND_FOLLOWUP_HOURS=72
