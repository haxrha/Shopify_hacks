{
  "name": "shopify-hack",
  "version": "0.1.0",
  "private": true,
  "description": "Group-chat food ordering agent: Linq (iMessage) + DoorDash CLI + Stripe bill splitting",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "setup:line": "tsx scripts/setup-line.ts",
    "setup:webhook": "tsx scripts/setup-webhook.ts"
  },
  "dependencies": {
    "@linqapp/sdk": "^0.39.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
